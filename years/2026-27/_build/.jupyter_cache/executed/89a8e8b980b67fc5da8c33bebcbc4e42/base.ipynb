   "source": [
    "import numpy as np\n",
    "\n",
    "# Labels of 6 datapoints, with K = 4 classes\n",
    "y = np.array([0, 2, 1, 3, 2, 0])\n",
    "K = 4\n",
    "\n",
    "# Row k of the identity matrix is exactly e_k\n",
    "Y_onehot = np.eye(K)[y]\n",
    "print(Y_onehot)"
   ]
  }
